<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Assert-based self-check, run: dotnet run (project src/OrderEndpoint.Tests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Fixtures use the learning persistence and a test saga, not the SQL persistence of the endpoint -->
    <SqlPersistenceGenerateScripts>false</SqlPersistenceGenerateScripts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageReference Include="NServiceBus.Testing" Version="10.1.0" />
    <ProjectReference Include="..\OrderEndpoint\OrderEndpoint.csproj" />
  </ItemGroup>

</Project>
